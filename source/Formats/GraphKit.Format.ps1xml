<?xml version="1.0" encoding="utf-8"?>
<!--
    Default display views for GraphKit result types.

    Registered via FormatsToProcess in GraphKit.psd1 and packaged via CopyPaths in
    build.yaml. Both are required: CopyPaths alone packages the file without
    registering it, and the views then silently never apply.

    Views are added as GraphKit.<Type> objects are introduced. The GraphKit.OperationResult
    view below is the envelope returned by Invoke-GraphOperation and Invoke-GraphBatch.
-->
<Configuration>
    <ViewDefinitions>
        <View>
            <Name>GraphKit.OperationResult</Name>
            <ViewSelectedBy>
                <TypeName>GraphKit.OperationResult</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Outcome</Label>
                        <Width>14</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Certainty</Label>
                        <Width>14</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Count</Label>
                        <Width>8</Width>
                        <Alignment>Right</Alignment>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Tenant</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>ApiVersion</Label>
                        <Width>10</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>RetrievedUtc</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>Outcome</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Certainty</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>@($_.Data).Count</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.Provenance.TenantId</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.Provenance.ApiVersion</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.Provenance.RetrievedUtc</ScriptBlock>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>GraphKit.ManagedDevice</Name>
            <ViewSelectedBy>
                <TypeName>GraphKit.ManagedDevice</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>DeviceName</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>OS</Label>
                        <Width>16</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Compliance</Label>
                        <Width>14</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>LastSync</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Tenant</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>deviceName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>operatingSystem</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>complianceState</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>lastSyncDateTime</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>_Tenant</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>GraphKit.MobileApp</Name>
            <ViewSelectedBy>
                <TypeName>GraphKit.MobileApp</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>DisplayName</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Publisher</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>AppType</Label>
                        <Width>22</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Tenant</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>RetrievedUtc</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>displayName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>publisher</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>($_.'@odata.type' -replace '^#microsoft\.graph\.', '')</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>_Tenant</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>_RetrievedUtc</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>GraphKit.DeviceConfiguration</Name>
            <ViewSelectedBy>
                <TypeName>GraphKit.DeviceConfiguration</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>DisplayName</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Type</Label>
                        <Width>22</Width>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>LastModified</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Tenant</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>RetrievedUtc</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>displayName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>($_.'@odata.type' -replace '^#microsoft\.graph\.', '')</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>lastModifiedDateTime</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>_Tenant</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>_RetrievedUtc</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
    </ViewDefinitions>
</Configuration>
